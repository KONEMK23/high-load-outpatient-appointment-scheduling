						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[agent.patientType = 1;
N_U++;

double arrivalTime = time();
int EPS = (int) (floor(arrivalTime * 6 + 2));

while (appts[EPS - 1] == 1) {
    EPS++;
}

appts[EPS - 1] = 1;
agent.W = (EPS - 1) * (1.0 / 6.0) - arrivalTime;

// Waiting time is already known at booking. Collect it here so the
// 50,000-arrival stopping rule does not censor patients still waiting.
if (patientsServed >= 500) {
    waitStats500.add(agent.W);
}
if (patientsServed >= 1000) {
    waitStats.add(agent.W);
    waitStats_U.add(agent.W);
}
if (patientsServed >= 2000) {
    waitStats2000.add(agent.W);
}

patientsArrived++;
if (patientsArrived >= 50000) {
    finishSimulation();
}]]></Code>
