			<AfterIterationCode><![CDATA[double mu = hist_mu.mean();
double hw = hist_mu.meanConfidence();
double muU = hist_mu_U.mean();
double hwU = hist_mu_U.meanConfidence();
double muR = hist_mu_R.mean();
double hwR = hist_mu_R.meanConfidence();

traceln("Q3 independent replications: " + hist_mu.count());
traceln("Q3 policy parameters: alpha1 = 0, alpha2 = 0.35");
traceln("Q3 urgent mean (days): " + muU);
traceln("Q3 urgent 95% CI: [" + (muU - hwU) + ", " + (muU + hwU) + "]");
traceln("Q3 routine mean (days): " + muR);
traceln("Q3 routine 95% CI: [" + (muR - hwR) + ", " + (muR + hwR) + "]");
traceln("Q3 overall mean (days): " + mu);
traceln("Q3 overall 95% CI: [" + (mu - hw) + ", " + (mu + hw) + "]");
traceln("Q3 overall relative CI half-width: " + (hw / mu));
traceln("Constraint satisfied (overall mean <= 5 days): " + (mu <= 5.0));]]></AfterIterationCode>
