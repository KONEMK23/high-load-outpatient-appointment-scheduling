		<ActiveObjectClass>
			<Id>1784286959365</Id>
			<Name><![CDATA[Main]]></Name>
			<DestroyCode><![CDATA[// Report this replication's post-warm-up results.
// A valid 95% confidence interval is calculated later from independent
// replication means, not from serially dependent patient observations.
double n = waitStats.count();

traceln("Arrivals at stop: " + patientsArrived);
traceln("Patients served at stop: " + patientsServed);
traceln("Post-warm-up observations: " + n);

if (n > 0) {
    traceln("Overall mean wait (days): " + waitStats.mean());
    traceln("Urgent mean wait (days): " + waitStats_U.mean());
    traceln("Routine mean wait (days): " + waitStats_R.mean());
    traceln("Patient-level standard deviation (days): " + waitStats.deviation());
}]]></DestroyCode>
			<Generic>false</Generic>
